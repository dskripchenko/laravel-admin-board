{
    "name": "dskripchenko/laravel-admin-board",
    "description": "Collaborative boards for dskripchenko/laravel-admin: a whiteboard per record or on its own, with server-ordered changes, presence and optional realtime.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "whiteboard",
        "board",
        "collaboration",
        "realtime",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-admin-board",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-admin-board/issues",
        "source": "https://github.com/dskripchenko/laravel-admin-board"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "dskripchenko/laravel-admin": "^1.69"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "dskripchenko/laravel-realtime": "Push board changes and presence over WebSockets instead of polling"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminBoard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminBoard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\LaravelAdminBoard\\AdminBoardServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
